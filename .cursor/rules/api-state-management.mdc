### Client Component Data Mutations
```typescript
'use client';
export const CreateUserForm = ({ onSuccess }: CreateUserFormProps) => {
  const [isSubmitting, setIsSubmitting] = useState(false);
  const form = useForm<CreateUserValues>();

  const handleSubmit = async (data: CreateUserValues) => {
    setIsSubmitting(true);
    
    try {
      const result = await safeCreateUser(data.email, data.password);
      
      if (result.success) {
        toast({
          title: 'Success',
          description: 'User created successfully',
        });
        form.reset();
        onSuccess?.(result.data);
      } else {
        if (result.validationErrors) {
          result.validationErrors.forEach((error) => {
            form.setError(error.field as keyof CreateUserValues, {
              message: error.message,
            });
          });
        } else {
          toast({
            title: 'Error',
            description: result.error,
            variant: 'destructive',
          });
        }
      }
    } catch (error) {
      toast({
        title: 'Error',
        description: 'An unexpected error occurred',
        variant: 'destructive',
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(handleSubmit)}>
        <InputField fieldName="email" label="Email" />
        <InputField fieldName="password" label="Password" type="password" />
        <Button type="submit" disabled={isSubmitting}>
          {isSubmitting ? 'Creating...' : 'Create User'}
        </Button>
      </form>
    </Form>
  );
};
```

## Performance Optimization

### Request Deduplication
```typescript
// Cache API responses to prevent duplicate requests
const requestCache = new Map<string, Promise<any>>();

export const getCachedApiCall = async <T>(
  key: string,
  apiCall: () => Promise<T>,
  ttl: number = 5000 // 5 seconds
): Promise<T> => {
  if (requestCache.has(key)) {
    return requestCache.get(key);
  }

  const promise = apiCall();
  requestCache.set(key, promise);

  // Clear cache after TTL
  setTimeout(() => {
    requestCache.delete(key);
  }, ttl);

  return promise;
};

// Usage
export const getUsers = async (params: GetUsersParams) => {
  const cacheKey = `users-${JSON.stringify(params)}`;
  return getCachedApiCall(cacheKey, () => _getUsers(params));
};
```

### Optimistic Updates
```typescript
export const useOptimisticUserUpdate = () => {
  const [users, setUsers] = useState<User[]>([]);

  const updateUser = async (id: string, updates: Partial<User>) => {
    // Optimistic update
    setUsers(prev => 
      prev.map(user => 
        user.id === id ? { ...user, ...updates } : user
      )
    );

    try {
      const updatedUser = await updateUserApi(id, updates);
      // Update with server response
      setUsers(prev => 
        prev.map(user => 
          user.id === id ? updatedUser : user
        )
      );
    } catch (error) {
      // Revert optimistic update
      setUsers(prev => 
        prev.map(user => 
          user.id === id ? { ...user, ...updates } : user
        )
      );
      throw error;
    }
  };

  return { users, updateUser };
};
```