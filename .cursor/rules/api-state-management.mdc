# API Integration & State Management

## API Architecture
- Centralized API client in [src/lib/api/api.ts](mdc:src/lib/api/api.ts)
- Module-specific API functions in `src/lib/api/[module]/`
- Server actions marked with 'use server' directive
- Environment-aware configuration with cookie-based authentication

## API Client Setup

### Central API Client
```typescript
'use server';
import axios from 'axios';
import { cookies } from 'next/headers';
import { _getEnv } from '@/lib/logic/EnvManager';
import { redirect, RedirectType } from 'next/navigation';

export const getApiClient = async (env?: string) => {
  const envCookie = (await cookies()).get('activeEnv');
  const envDetails = await _getEnv(env ?? envCookie?.value ?? 'Local');

  const axiosInstance = axios.create({
    baseURL: envDetails.baseUrl,
    withCredentials: true,
    timeout: 50000,
    headers: {
      'Content-Type': 'application/json',
      Accept: 'application/json',
      masterkey: envDetails.masterKey,
    },
  });

  // Request interceptor for auth
  axiosInstance.interceptors.request.use(
    async config => {
      if (config.headers.Authorization) return config;
      const accessToken = (await cookies()).get(`${envDetails.name}AccessToken`);
      if (!accessToken) return config;
      config.headers.Authorization = `Bearer ${accessToken.value}`;
      return config;
    },
    error => Promise.reject(error)
  );

  // Response interceptor for error handling
  axiosInstance.interceptors.response.use(
    response => response,
    async error => {
      const { response } = error;
      if (response?.status === 401 && error.request.path !== '/admin/login') {
        redirect('/login?session-timeout=true', RedirectType.replace);
      }
      return Promise.reject(error);
    }
  );

  return axiosInstance;
};
```

### Module-Specific API Functions
```typescript
'use server';
import { getApiClient } from '@/lib/api';
import { User } from '@/lib/models/User';

// GET endpoints with parameters
export const getUsers = async (
  skip: number,
  limit: number,
  params?: {
    sort?: string;
    search?: string;
    isActive?: boolean;
    provider?: string;
  }
): Promise<{ users: User[]; count: number }> => {
  const client = await getApiClient();
  const response = await client.get('/authentication/users', {
    params: { skip, limit, ...params },
  });
  return response.data;
};

// POST endpoints
export const createUser = async (
  email: string,
  password: string
): Promise<User> => {
  const client = await getApiClient();
  const response = await client.post('/authentication/users', {
    email,
    password,
  });
  return response.data;
};

// PUT endpoints
export const updateUser = async (
  id: string,
  data: Partial<User>
): Promise<User> => {
  const client = await getApiClient();
  const response = await client.put(`/authentication/users/${id}`, data);
  return response.data;
};

// DELETE endpoints
export const deleteUser = async (id: string): Promise<void> => {
  const client = await getApiClient();
  await client.delete(`/authentication/users/${id}`);
};
```

## Error Handling Patterns

### API Error Types
```typescript
export interface ApiError {
  message: string;
  status: number;
  statusText: string;
  url?: string;
  method?: string;
  data?: any;
}

export interface ValidationError {
  field: string;
  message: string;
}

export interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: string;
  validationErrors?: ValidationError[];
}
```

### Error Handling Utilities
```typescript
export const handleApiError = (error: any): ApiResponse<never> => {
  if (error.response) {
    // Server responded with error status
    const { status, statusText, data } = error.response;
    
    if (status === 422 && data.validationErrors) {
      return {
        success: false,
        error: 'Validation failed',
        validationErrors: data.validationErrors,
      };
    }
    
    return {
      success: false,
      error: data.message || statusText || 'An error occurred',
    };
  } else if (error.request) {
    // Network error
    return {
      success: false,
      error: 'Network error. Please check your connection.',
    };
  } else {
    // Request setup error
    return {
      success: false,
      error: 'An unexpected error occurred.',
    };
  }
};

// Usage in API functions
export const safeCreateUser = async (
  email: string,
  password: string
): Promise<ApiResponse<User>> => {
  try {
    const user = await createUser(email, password);
    return { success: true, data: user };
  } catch (error) {
    return handleApiError(error);
  }
};
```

## State Management Patterns

### React Context for Global State
```typescript
// Context definition
interface AppContextType {
  user: User | null;
  environment: string;
  modules: Module[];
  setUser: (user: User | null) => void;
  setEnvironment: (env: string) => void;
  isLoading: boolean;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

// Provider component
export const AppProvider = ({ children }: { children: React.ReactNode }) => {
  const [user, setUser] = useState<User | null>(null);
  const [environment, setEnvironment] = useState('Local');
  const [modules, setModules] = useState<Module[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    const initializeApp = async () => {
      try {
        const [userData, moduleData] = await Promise.all([
          getCurrentUser(),
          getModules(),
        ]);
        setUser(userData);
        setModules(moduleData);
      } catch (error) {
        console.error('Failed to initialize app:', error);
      } finally {
        setIsLoading(false);
      }
    };

    initializeApp();
  }, [environment]);

  const value = {
    user,
    environment,
    modules,
    setUser,
    setEnvironment,
    isLoading,
  };

  return <AppContext.Provider value={value}>{children}</AppContext.Provider>;
};

// Hook for consuming context
export const useApp = () => {
  const context = useContext(AppContext);
  if (context === undefined) {
    throw new Error('useApp must be used within an AppProvider');
  }
  return context;
};
```

### URL State Management
```typescript
'use client';
import { useSearchParams, useRouter, usePathname } from 'next/navigation';
import { useCallback } from 'react';

export const useUrlParams = () => {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();

  const updateParams = useCallback(
    (updates: Record<string, string | number | boolean | null>) => {
      const params = new URLSearchParams(searchParams.toString());
      
      Object.entries(updates).forEach(([key, value]) => {
        if (value === null || value === undefined || value === '') {
          params.delete(key);
        } else {
          params.set(key, String(value));
        }
      });

      const newUrl = `${pathname}?${params.toString()}`;
      router.push(newUrl);
    },
    [searchParams, pathname, router]
  );

  const getParam = useCallback(
    (key: string, defaultValue?: string) => {
      return searchParams.get(key) ?? defaultValue;
    },
    [searchParams]
  );

  return { updateParams, getParam, searchParams };
};

// Usage in components
export const UserList = () => {
  const { updateParams, getParam } = useUrlParams();
  const currentPage = parseInt(getParam('page', '1'));
  const searchTerm = getParam('search', '');

  const handlePageChange = (page: number) => {
    updateParams({ page });
  };

  const handleSearch = (search: string) => {
    updateParams({ search, page: 1 }); // Reset to page 1 on search
  };

  return (
    <div>
      <SearchInput value={searchTerm} onChange={handleSearch} />
      <UserTable page={currentPage} search={searchTerm} />
      <Pagination current={currentPage} onChange={handlePageChange} />
    </div>
  );
};
```

### Server State with React Query Pattern
```typescript
// Custom hook for server state
export const useUsers = (
  params: {
    page?: number;
    limit?: number;
    search?: string;
    isActive?: boolean;
  } = {}
) => {
  const [users, setUsers] = useState<User[]>([]);
  const [count, setCount] = useState(0);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchUsers = useCallback(async () => {
    setIsLoading(true);
    setError(null);
    
    try {
      const { page = 1, limit = 10, ...otherParams } = params;
      const skip = (page - 1) * limit;
      const result = await getUsers(skip, limit, otherParams);
      
      setUsers(result.users);
      setCount(result.count);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to fetch users');
    } finally {
      setIsLoading(false);
    }
  }, [params]);

  useEffect(() => {
    fetchUsers();
  }, [fetchUsers]);

  const refetch = () => {
    fetchUsers();
  };

  return {
    users,
    count,
    isLoading,
    error,
    refetch,
  };
};

// Usage in components
export const UsersPage = () => {
  const { updateParams, getParam } = useUrlParams();
  const page = parseInt(getParam('page', '1'));
  const search = getParam('search', '');
  
  const { users, count, isLoading, error, refetch } = useUsers({
    page,
    search,
    limit: 10,
  });

  if (error) {
    return <ErrorDisplay message={error} onRetry={refetch} />;
  }

  return (
    <div>
      <UserTable users={users} loading={isLoading} />
      <Pagination
        current={page}
        total={count}
        pageSize={10}
        onChange={(newPage) => updateParams({ page: newPage })}
      />
    </div>
  );
};
```

## Data Fetching Patterns

### Server Components Data Fetching
```typescript
// Server component with data fetching
export default async function UsersPage({
  searchParams,
}: {
  searchParams: { page?: string; search?: string };
}) {
  const page = parseInt(searchParams.page ?? '1');
  const search = searchParams.search ?? '';
  const skip = (page - 1) * 10;

  const { users, count } = await getUsers(skip, 10, { search });

  return (
    <div>
      <UserTableClient 
        initialUsers={users} 
        initialCount={count}
        page={page}
        search={search}
      />
    </div>
  );
}
